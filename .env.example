# Copy to .env.local and fill in values. Never commit .env.local.
#
# Tests need a second file, .env.test, pointing at the LOCAL Supabase stack
# (supabase start prints the URL and keys). Vitest and Playwright refuse to
# run against anything other than 127.0.0.1; the hosted project is the shared
# dev and demo environment.

# Supabase project (hosted dev project or local CLI stack)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Required by npm run seed. Not exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# development | staging | production
# Quick-login buttons are compiled out unless development or staging.
NEXT_PUBLIC_ENV=development

# Shared password for the six seeded test accounts
TEST_PASSWORD=
# Exposed to the client in development and staging builds only,
# so the quick-login buttons can sign in. Leave empty in production.
NEXT_PUBLIC_TEST_PASSWORD=
